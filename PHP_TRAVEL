function formatPHT(d){return new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Manila',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit',hour12:false}).format(d)+' PHT';}
function updateCountdown(){
  const now=new Date(); const next=EVENTS.find(e=>new Date(e.at).getTime()>now.getTime());
  if(!next){document.getElementById('nextTitle').textContent='行程已结束';document.getElementById('nextTime').textContent='—';return;}
  const diff=Math.max(0,new Date(next.at).getTime()-now.getTime());
  const dd=Math.floor(diff/86400000), hh=Math.floor(diff%86400000/3600000), mm=Math.floor(diff%3600000/60000), ss=Math.floor(diff%60000/1000);
  document.getElementById('nextTitle').textContent=next.title;document.getElementById('nextTime').textContent=formatPHT(new Date(next.at));
  document.getElementById('dd').textContent=String(dd).padStart(2,'0');document.getElementById('hh').textContent=String(hh).padStart(2,'0');document.getElementById('mm').textContent=String(mm).padStart(2,'0');document.getElementById('ss').textContent=String(ss).padStart(2,'0');
}
